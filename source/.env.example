# Copy to .env and fill values from your Supabase project.
# Never commit the real .env file or expose service-role / server secrets.

# Public Supabase settings (also embedded at build time for the browser)
SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
AI_GATEWAY_API_KEY="YOUR_AI_GATEWAY_API_KEY"
CRON_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
# Optional during secret rotation
CRON_SECRET_PREVIOUS=""

# Only needed when running Drizzle migrations against the database
DATABASE_MIGRATION_URL="YOUR_DATABASE_MIGRATION_CONNECTION_STRING"
